# ============================================================
# Honghu AI — local environment template
# Copy to ".env" (git-ignored) and fill in what you need:
#   cp .env.example .env
# ============================================================

# ---- AI provider keys: set AT LEAST ONE to enable chat ----
# Default routed model is "deepseek-chat" → needs DEEPSEEK_CLOUD_API_KEY.
DEEPSEEK_CLOUD_API_KEY=
OPENAI_API_KEY=
ALIYUN_API_KEY=
GEMINI_API_KEY=

# ---- Optional: a local Ollama running on the host machine ----
# Leave as-is to reach the host from inside the container.
OLLAMA_LOCAL_BASE_URL=http://host.docker.internal:11434

# ---- Datastore credentials (must match docker-compose) ----
DB_NAME=postgres
DB_PASSWORD=12345
REDIS_PASSWORD=12345

# ---- Feature toggles ----
# S3 upload & SQS-driven RAG ingestion need real AWS (or LocalStack).
# They are OFF by default so the stack boots with one command.
AWS_S3_ENABLED=false
AWS_SQS_ENABLED=false
APP_RAG_LISTENER_ENABLED=false
