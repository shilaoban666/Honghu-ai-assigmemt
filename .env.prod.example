# ============================================================
# 生产环境变量模板 —— 放到 EC2 的 /opt/honghu-ai/.env
#   cp .env.prod.example .env   然后填入真实值
# 注意：AWS 凭证不在这里填，改用 EC2 IAM Role（见 DEPLOY.md）。
# ============================================================

# 要部署的镜像 tag（一键部署时也可在 workflow 输入覆盖）
IMAGE_TAG=latest

# ---- 数据存储（容器内主机名，密码请改强密码）----
DB_NAME=honghu
DB_PASSWORD=__CHANGE_ME__
REDIS_PASSWORD=__CHANGE_ME__

# ---- AWS（区域；凭证走实例角色，勿填 key）----
AWS_REGION=us-east-1
# 桶名/队列名若与 application.yml 默认值一致则无需设置：
#   桶 honghu-ai-document-upload / honghu-ai-avatar，队列 honghu-ai-document-upload-received

# ---- AI provider（至少一个；也可改为在后台「Provider 注册表」里加密保存）----
DEEPSEEK_CLOUD_API_KEY=__CHANGE_ME__

# ---- 密钥加密（重要！）----
# 后台「Provider 注册表」保存的模型 API Key 用 AES-GCM 加密，主密钥取自这里。
# 生产必须设为稳定的强随机长字符串；一旦更改或丢失，已加密的 Key 将无法解密。
APP_SKILL_SECRET_KEY=__CHANGE_ME_TO_A_LONG_RANDOM_STRING__

# ---- CORS：真实前端域名（逗号分隔可多个）----
APP_CORS_ALLOWED_ORIGINS=https://www.your-domain.com
