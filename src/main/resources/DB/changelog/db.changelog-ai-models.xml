<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="7" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="user_role"/>
            </not>
        </preConditions>
        <addColumn tableName="users">
            <column name="user_role" type="VARCHAR(20)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex indexName="idx_users_role" tableName="users">
            <column name="user_role"/>
        </createIndex>
    </changeSet>

    <changeSet id="8" author="copilot">
        <createTable tableName="ai_model_definition">
            <column name="model_code" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
            <column name="provider_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="api_model_name" type="VARCHAR(160)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="local_model" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="supports_stream" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_ai_model_provider" tableName="ai_model_definition">
            <column name="provider_code"/>
        </createIndex>
        <createIndex indexName="idx_ai_model_level" tableName="ai_model_definition">
            <column name="level"/>
        </createIndex>
    </changeSet>

    <changeSet id="9" author="copilot">
        <createTable tableName="user_model_permission">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="model_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_model_permission"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"
                                 constraintName="fk_user_model_permission_user"/>
        <addForeignKeyConstraint baseTableName="user_model_permission"
                                 baseColumnNames="model_code"
                                 referencedTableName="ai_model_definition"
                                 referencedColumnNames="model_code"
                                 constraintName="fk_user_model_permission_model"/>
        <addUniqueConstraint tableName="user_model_permission"
                             columnNames="user_id,model_code"
                             constraintName="uk_user_model_permission_user_model"/>
        <createIndex indexName="idx_user_model_permission_user_id" tableName="user_model_permission">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="idx_user_model_permission_model_code" tableName="user_model_permission">
            <column name="model_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="9.1" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ai_model_definition" columnName="score"/>
            </not>
        </preConditions>

        <!--
            score 用于同一梯队内的模型排序：
            1. level 负责“第几梯队”
            2. score 负责“同梯队内谁更靠前”
            之所以单独追加 changeSet，而不是直接改 createTable，
            是为了兼容已经执行过历史迁移的数据库，避免 Liquibase checksum 混乱。
        -->
        <addColumn tableName="ai_model_definition">
            <column name="score" type="INT" defaultValueNumeric="0" valueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="9.2" author="copilot">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="ai_model_definition" columnName="score"/>
                <not>
                    <indexExists tableName="ai_model_definition" indexName="idx_ai_model_score"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="idx_ai_model_score" tableName="ai_model_definition">
            <column name="score"/>
        </createIndex>
    </changeSet>

