<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="shilaoban">
        <createTable tableName="chat_session">
            <column name="session_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_name" type="VARCHAR(255)"/>
            <column name="system_role" type="VARCHAR(64)"/>
            <column name="session_name" type="VARCHAR(64)"/>
            <column name="session_status" type="VARCHAR(64)" defaultValue="active"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="shilaoban">
        <createTable tableName="chat_message">
            <column name="chat_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(64)">
                <constraints nullable="false" foreignKeyName="fk_chat_message_session" referencedTableName="chat_session" referencedColumnNames="session_id"/>
            </column>
            <column name="chat_role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="pending"/>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex indexName="idx_session_id" tableName="chat_message">
            <column name="session_id"/>
        </createIndex>
    </changeSet>

    <!-- 引入用户表变更日志 -->
    <include file="DB/changelog/db.changelog-users.xml" relativeToChangelogFile="false"/>

    <!-- 引入 AI 任务路由关键词表变更日志 -->
    <include file="DB/changelog/db.changelog-ai-task-keywords.xml" relativeToChangelogFile="false"/>

    <!-- 引入中期记忆摘要与用户主体画像表变更日志 -->
    <include file="DB/changelog/db.changelog-memory-summary.xml" relativeToChangelogFile="false"/>

    <!-- 引入 AI 模型目录与用户模型权限表 -->
    <include file="DB/changelog/db.changelog-ai-models.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>

