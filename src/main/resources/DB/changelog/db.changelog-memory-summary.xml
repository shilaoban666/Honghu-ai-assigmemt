<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="5" author="copilot">
        <createTable tableName="chat_session_profile">
            <column name="session_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="profile_summary" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="last_summarized_chat_id" type="BIGINT"/>
            <column name="summarized_message_count" type="INT"/>
            <column name="summary_model" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="chat_session_profile"
                                 baseColumnNames="session_id"
                                 referencedTableName="chat_session"
                                 referencedColumnNames="session_id"
                                 constraintName="fk_chat_session_profile_session"/>
        <addForeignKeyConstraint baseTableName="chat_session_profile"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"
                                 constraintName="fk_chat_session_profile_user"/>
        <createIndex tableName="chat_session_profile" indexName="idx_chat_session_profile_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="chat_session_profile" indexName="idx_chat_session_profile_updated_at">
            <column name="updated_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="6" author="copilot">
        <createTable tableName="user_profile_snapshot">
            <column name="user_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profile_summary" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="source_session_count" type="INT"/>
            <column name="source_session_ids" type="TEXT"/>
            <column name="summary_model" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_profile_snapshot"
                                 baseColumnNames="user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"
                                 constraintName="fk_user_profile_snapshot_user"/>
        <createIndex tableName="user_profile_snapshot" indexName="idx_user_profile_snapshot_updated_at">
            <column name="updated_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

