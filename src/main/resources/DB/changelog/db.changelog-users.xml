<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="3" author="shilaoban">
        <comment>创建用户表</comment>
        <createTable tableName="users">
            <!-- 用户 ID（UUID） -->
            <column name="user_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <!-- 用户名（登录名） -->
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            
            <!-- 昵称 -->
            <column name="nickname" type="VARCHAR(100)"/>
            
            <!-- 手机号 -->
            <column name="phone" type="VARCHAR(20)">
                <constraints unique="true"/>
            </column>
            
            <!-- 邮箱 -->
            <column name="email" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>
            
            <!-- 密码（加密存储） -->
            <column name="password" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            
            <!-- 性别：MALE, FEMALE, OTHER -->
            <column name="gender" type="VARCHAR(10)" defaultValue="OTHER"/>
            
            <!-- 用户状态：ACTIVE, INACTIVE, BANNED -->
            <column name="user_status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            
            <!-- 家庭地址 -->
            <column name="home_address" type="VARCHAR(500)"/>
            
            <!-- 创建时间 -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            
            <!-- 更新时间 -->
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- 创建索引 -->
        <createIndex indexName="idx_users_username" tableName="users">
            <column name="username"/>
        </createIndex>
        
        <createIndex indexName="idx_users_phone" tableName="users">
            <column name="phone"/>
        </createIndex>
        
        <createIndex indexName="idx_users_email" tableName="users">
            <column name="email"/>
        </createIndex>
        
        <createIndex indexName="idx_users_status" tableName="users">
            <column name="user_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
